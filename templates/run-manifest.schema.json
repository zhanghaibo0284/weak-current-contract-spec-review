{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/weak-current-contract-spec-review/run-manifest.schema.json",
  "title": "审查运行清单",
  "description": "一次审查运行的内容寻址记录。只含内容指纹与参数轴，不含时间戳、主机名、绝对路径。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_hash",
    "params_hash",
    "ruleset_checksum",
    "output_hash",
    "review_date",
    "stance",
    "profile"
  ],
  "properties": {
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "归一化输入（正文块 + 表格网格 + 材料清单）的 SHA-256"
    },
    "params_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "参数轴（stance/profile/recall/review_date/rule_version/locale）的 SHA-256"
    },
    "ruleset_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "运行时锁定的规则集指纹"
    },
    "output_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "问题清单 + 覆盖台账 + manifest 核心的 SHA-256"
    },
    "review_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "唯一时间来源，禁止使用系统时钟"
    },
    "stance": {
      "type": "string",
      "enum": ["seller", "gc", "owner", "supervisor"]
    },
    "profile": {
      "type": "string",
      "enum": ["quick", "standard", "verify"]
    },
    "recall": {
      "type": "string",
      "enum": ["wide", "standard", "narrow"]
    },
    "rule_version": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "parser_version": {
      "type": "string",
      "description": "文档解析器名称与版本，用于复现解析差异"
    }
  }
}
